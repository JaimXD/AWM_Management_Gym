generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  TRAINER
}

enum Difficulty {
  PRINCIPIANTE
  INTERMEDIO
  AVANZADO
}

enum MemberStatus {
  ACTIVO
  INACTIVO
}

enum MembershipStatus {
  ACTIVA
  VENCIDA
  CANCELADA
}

enum ReservationStatus {
  RESERVADA
  CANCELADA
  ASISTIO
}

model Role {
  id    Int      @id @default(autoincrement())
  name  RoleName @unique
  users User[]
}

model User {
  id                Int                    @id @default(autoincrement())
  name              String
  email             String                 @unique
  emailVerifiedAt   DateTime?
  password          String
  roleId            Int
  role              Role                   @relation(fields: [roleId], references: [id])
  reservations      ClassReservation[]
  createdAt         DateTime               @default(now())
  tokenVersion      Int                    @default(0)
  passwordReset     PasswordReset?
  emailVerification UserEmailVerification?
}

model Member {
  id                Int                      @id @default(autoincrement())
  firstName         String
  lastName          String
  cedula            String                   @unique
  email             String
  emailVerifiedAt   DateTime?
  emailVerification MemberEmailVerification?
  phone             String
  status            MemberStatus             @default(ACTIVO)
  createdAt         DateTime                 @default(now())

  account        MemberAccount?
  passwordResets MemberPasswordReset[]
  memberships    Membership[]
  reservations   ClassReservation[]
  workouts       Workout[]
}

model MemberEmailVerification {
  id              String    @id @default(cuid())
  memberId        Int       @unique
  email           String
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  windowStartedAt DateTime  @default(now())
  sendCount       Int       @default(1)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
}

model MemberAccount {
  id           Int      @id @default(autoincrement())
  memberId     Int      @unique
  passwordHash String
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())

  member         Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  passwordResets MemberPasswordReset[]
}

model MemberPasswordReset {
  id              String    @id @default(cuid())
  memberAccountId Int       @unique
  email           String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  windowStartedAt DateTime  @default(now())
  sendCount       Int       @default(1)

  memberAccount MemberAccount @relation(fields: [memberAccountId], references: [id], onDelete: Cascade)
  Member        Member?       @relation(fields: [memberId], references: [id])
  memberId      Int?
}

model UserEmailVerification {
  id              String    @id @default(cuid())
  userId          Int       @unique
  email           String
  codeHash        String
  expiresAt       DateTime
  attempts        Int       @default(0)
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  windowStartedAt DateTime  @default(now())
  sendCount       Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id           Int               @id @default(autoincrement())
  name         String
  muscleGroup  String
  difficulty   Difficulty
  description  String
  imageUrl     String?
  active       Boolean           @default(true)
  createdAt    DateTime          @default(now())
  workoutItems WorkoutExercise[]
}

model Workout {
  id        Int               @id @default(autoincrement())
  name      String
  memberId  Int
  member    Member            @relation(fields: [memberId], references: [id])
  createdAt DateTime          @default(now())
  items     WorkoutExercise[]
}

model WorkoutExercise {
  id         Int      @id @default(autoincrement())
  workoutId  Int
  exerciseId Int
  sets       Int
  reps       Int
  weight     Float
  workout    Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
}

model Class {
  id           Int                @id @default(autoincrement())
  name         String
  instructor   String
  date         DateTime
  capacity     Int
  booked       Int                @default(0)
  createdAt    DateTime           @default(now())
  reservations ClassReservation[]
}

model Membership {
  id        Int              @id @default(autoincrement())
  memberId  Int
  planName  String
  startsAt  DateTime
  expiresAt DateTime
  status    MembershipStatus @default(ACTIVA)
  price     Decimal          @db.Decimal(10, 2)
  createdAt DateTime         @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, expiresAt])
}

model ClassReservation {
  id          Int               @id @default(autoincrement())
  classId     Int
  memberId    Int
  status      ReservationStatus @default(RESERVADA)
  bookedAt    DateTime          @default(now())
  cancelledAt DateTime?

  class  Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)
  User   User?  @relation(fields: [userId], references: [id])
  userId Int?

  @@unique([classId, memberId])
  @@index([memberId, status])
}

model PasswordReset {
  userId          Int       @id
  email           String
  tokenHash       String    @unique
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
  windowStartedAt DateTime  @default(now())
  sendCount       Int       @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
